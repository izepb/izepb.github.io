---
// Thumbnail: an image if given, otherwise a small network glyph seeded by `seed` (deterministic per item).
interface Props { src?: string; seed: string; alt?: string; href?: string; }
const { src, seed, alt = '', href } = Astro.props;

let h = 2166136261;
for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
const rand = () => ((h = Math.imul(h ^ (h >>> 15), 2246822507) ^ Math.imul(h ^ (h >>> 13), 3266489909)) >>> 0) / 4294967296;
const pts = Array.from({ length: 9 }, () => [12 + rand() * 96, 10 + rand() * 60]);
// Connected tree: each node links to its nearest earlier node, plus a couple of extra edges.
const d = (a: number[], b: number[]) => Math.hypot(a[0] - b[0], a[1] - b[1]);
const edges: [number, number][] = pts.slice(1).map((p, k) => {
  const i = k + 1;
  const j = pts.slice(0, i).reduce((best, q, jj) => (d(p, q) < d(p, pts[best]) ? jj : best), 0);
  return [j, i];
});
for (let e = 0; e < 2; e++) { const a = Math.floor(rand() * 9), b = Math.floor(rand() * 9); if (a !== b) edges.push([a, b]); }
const Tag = href ? 'a' : 'div';
---
<Tag class="thumb" href={href}>
  {src ? <img src={src} alt={alt} loading="lazy" /> : (
    <svg viewBox="0 0 120 80" aria-hidden="true">
      {edges.map(([a, b]) => <line x1={pts[a][0]} y1={pts[a][1]} x2={pts[b][0]} y2={pts[b][1]} />)}
      {pts.map(([x, y], i) => <circle cx={x} cy={y} r={i === 0 ? 5 : 3} class:list={{ hub: i === 0 }} />)}
    </svg>
  )}
</Tag>

<style>
  .thumb { display: block; width: 100%; aspect-ratio: 3 / 2; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: var(--card); }
  img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  svg { width: 100%; height: 100%; display: block; background: radial-gradient(circle, var(--line) .6px, transparent .6px) 0 0 / 8px 8px; }
  line { stroke: var(--edge); stroke-width: 1; }
  circle { fill: var(--bg); stroke: var(--node); stroke-width: 1.2; }
  circle.hub { fill: var(--node); }
</style>
